// Generador del lote de blog de Ilatek. // Uso: node blog/build/build-blog.mjs // // Salida (el total lo manda data/: añadir un post al catálogo añade su página): // 02-comparativas/posts/*.html .... una página por post del catálogo (familias, marcas, sustratos, intención) // 01-preguntas-frecuentes/*.html ... 6 clústeres de preguntas investigadas // 03-comunidades-servicios/*.html .. 8 puentes a comunidades y landings de servicio // */index.html + index.html ..... 4 índices // // Cada página pasa por tools/page-shell.mjs: nav y footer compartidos, contrato de // enlaces internos y runtime ya resueltos. Los metadatos no viven aquí: van a seo/seo-blog.csv // para configurarse en el panel SEO nativo de GHL. import fs from 'node:fs'; import path from 'node:path'; import { fileURLToPath } from 'node:url'; import { composeShell } from '././tools/page-shell.mjs'; import { FECHA, SITE, url, esc, link, hero, heroLite, crumbs, quick, verdict, toc, table, section, h3, paras, bullets, steps, panel, note, faq, ctaBlock, legal, sources, relatedCard, visitCard, asideService, asideFaqCluster, articleSchema, breadcrumbSchema, faqSchema, itemListSchema, webPageSchema, blogSchema, page } from './render.mjs'; import { imagenDePost } from './make-images.mjs'; import { cardImage } from './card-images.mjs'; // Las tablas del blog y las de la landing money salen del mismo módulo: una // sola definición de precios/comparativa, con cada sistema enlazado a su landing. import { comparisonTableHtml, systemPath } from '././techos/lib/tables.mjs'; // Bloques de enlace por entidad: marca e intención, desde los mismos datos. import { brandBlock, clusterLinks, intentBlock } from './link-blocks.mjs'; // Tarjeta de post: foto del servicio en un bloque propio y el texto debajo. // Nada de texto sobre la imagen: la foto se lee entera y el título va en su caja. function gridCard({ href, kicker, title, text, image }) { // La foto es decorativa: el nombre accesible lo da el título del enlace, y así // el contrato de localización no le inyecta el token del municipio (el blog no // es una página por pueblo). return `<li><a class="ilb-gridcard" href="${href}"> <figure class="ilb-gridcard-media"><img src="${esc(image.src)}" onerror="this.onerror=null;this.src='${esc(image.fallback)}';this.onerror=function(){this.onerror=null;this.src='${esc(image.fallback2 || image.fallback)}\'}" alt="${esc(image.alt || title)}" width="800" height="500" loading="lazy" decoding="async" data-service="${esc(image.key || '')}"></figure> <div class="ilb-gridcard-body"><span class="ilb-gridcard-kicker">${esc(kicker)}</span><h3>${esc(title)}</h3><p>${esc(text)}</p></div></a></li>`; } const HERE = path.dirname(fileURLToPath(import.meta.url)); const BLOG = path.resolve(HERE, '.'); const read = (f) => JSON.parse(fs.readFileSync(path.join(BLOG, 'data', f), 'utf8')); const sistemas = JSON.parse(fs.readFileSync(path.join(BLOG, 'data/sistemas.json'), 'utf8')); const catalogo = read('posts.json'); const editoriales = read('editoriales.json'); const preguntasData = read('preguntas.json'); const FAM = new Map(sistemas.familias.map(f => [f.id, f])); const MARCA = new Map(sistemas.marcas.map(m => [m.id, m])); const ED = new Map(editoriales.editoriales.map(e => [e.slug, e])); const CLUSTERS = preguntasData.clusters; const PREGUNTAS = preguntasData.preguntas; // ——— utilidades ——— const strip = (html) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); const words = (html) => strip(html).split(' ').filter(Boolean).length; const lc = (s) => s.charAt(0).toLowerCase() + s.slice(1); const joinNames = (arr) => arr.length <= 1 ? (arr[0] || '') : arr.slice(0, -1).join(', ') + ' y ' + arr[arr.length - 1]; const hash = (s) => [..s].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7); const famList = (p) => p.familias.map(id => FAM.get(id)).filter(Boolean); const marcaList = (p) => p.marcas.map(id => MARCA.get(id)).filter(Boolean); const famNames = (p) => joinNames(famList(p).map(f => f.nombre)); const marcaNames = (p) => joinNames(marcaList(p).map(m => m.nombre)); const KICKER = { familia: 'Comparativa de sistemas', marca: 'Comparativa de marcas', sustrato: 'Por tipo de techo', intencion: 'Guía práctica' }; const SUSTRATO_DEK = { zinc: 'un techo de zinc', concreto: 'una losa de concreto', madera: 'un techo de madera', teja: 'un techo de teja', asfalto: 'un techo de asfalto', plano: 'un techo plano', comercial: 'un techo comercial', industrial: 'un techo industrial', residencial: 'una casa', aluminio: 'un techo de aluminio', shingle: 'un techo de shingle', costero: 'un techo en zona costera', institucional: 'un techo institucional' }; const dekFor = (p) => { if (p.grupo === 'marca') { return `${marcaNames(p)} frente a frente: qué publica cada una sobre precio, garantía y protocolo, con la fecha de verificación y sin afiliación.`; } if (p.grupo === 'sustrato') { const t = SUSTRATO_DEK[p.sustrato] || `un techo de ${p.sustrato}`; return `Qué sistema pide ${t} en Puerto Rico, qué se revisa antes de aplicar y qué errores convierten un buen trabajo en una filtración al año.`; } if (p.grupo === 'intencion') { return 'Respuesta directa, cifras publicadas por empresas de Puerto Rico y el criterio para decidir sin depender de quien vende el producto.'; } return `${famNames(p)}: diferencias reales de precio publicado, duración, garantía y el criterio para elegir en el clima de la isla.`; }; // ——— bloques de contenido ——— function compareTable(p) { if (p.grupo === 'marca' && p.marcas.length) { return table({ caption: `Comparación publicada el ${FECHA}. Precios de producto, no instalados, salvo indicación.`, headers: ['Marca', 'Qué es', 'Garantía publicada', 'Precio publicado'], rows: marcaList(p).map(m => [ `<strong>${esc(m.nombre)}</strong><small>${esc(m.tipo)}</small>`, esc(m.nombreLargo), esc(m.garantia), m.precios.length ? `${esc(m.precios[0].producto)}: ${esc(m.precios[0].precio)}<small>${esc(m.precios[0].unidad)}</small>` : (m.precioInstalado ? esc(m.precioInstalado) : 'No publica precios') ]) }); } return table({ caption: `Datos publicados por los fabricantes y distribuidores el ${FECHA}.`, headers: ['Sistema', 'Qué es', 'Duración publicada', 'Precio publicado'], rows: famList(p).map(f => [ `<strong>${esc(f.nombre)}</strong>`, esc(f.material), esc(f.duracion), esc(f.precioPublicado) ]) }); } function priceSection(p) { const relevantes = p.marcas.length ? marcaList(p) : sistemas.marcas.filter(m => m.familias.some(f => p.familias.includes(f))).slice(0, 3); if (!relevantes.length) return ''; const rows = []; for (const m of relevantes) { if (!m.precios.length) { rows.push([ `<strong>${esc(m.nombre)}</strong>`, 'No publica lista de precios', '—', m.precioInstalado ? esc(m.precioInstalado) : 'No publicado' ]); continue; } for (const pr of m.precios.slice(0, 4)) { rows.push([ `<strong>${esc(m.nombre)}</strong><small>${esc(pr.producto)}</small>`, `<a href="${esc(pr.url)}" target="_blank" rel="noopener noreferrer nofollow">${esc(pr.precio)}</a>`, esc(pr.unidad), m.precioInstalado ? esc(m.precioInstalado) : 'No publicado' ]); } } return section('precio-publicado', 'Precio publicado y qué incluye', ` <p>Estos son los precios que cada empresa publica en su propia tienda o página, verificados el <time datetime="${FECHA}">4 de noviembre de 2026</time>. Son precios de producto por paila o galón, no precios instalados por pie cuadrado, salvo donde la columna lo indique.</p> ${table({ caption: 'Precio de lista publicado por cada marca. No incluye mano de obra ni preparación.', headers: ['Marca y producto', 'Precio publicado', 'Unidad', 'Precio instalado publicado'], rows })} ${note(`<strong>Cómo leer esto:</strong> una paila más barata no es un techo más barato. Lo que decide el costo final es cuántas pailas consume el área, cuántas manos pide el sistema y cuánto cuesta la preparación. Si una marca no publica cobertura por área, pide la ficha técnica antes de comparar.`)}`); } function systemsSection(p) { const partes = famList(p).map(f => ` ${h3(f.nombre)} ${paras([ `${esc(f.material)} Se aplica en ${lc(f.capas)}`, `<strong>Cobertura:</strong> ${esc(f.cobertura)} <strong>Duración publicada:</strong> ${esc(f.duracion)}`, `<strong>Garantía:</strong> ${esc(f.garantia)}` ])} `); return section('que-es-cada-sistema', p.grupo === 'marca' ? 'Qué protocolo vende cada marca' : 'Qué es cada sistema', partes.join('')); } function prosConsSection(p) { return section('ventajas-y-desventajas', 'Ventajas y desventajas reales', ` ${table({ caption: 'Resumen de lo que cada sistema resuelve y de lo que no.', headers: ['Sistema', 'A favor', 'En contra'], rows: famList(p).map(f => [ `<strong>${esc(f.nombre)}</strong>`, `<ul style="margin:0;padding-left:18px">${f.fuerte.map(x => `<li>${esc(x)}</li>`).join('')}</ul>`, `<ul style="margin:0;padding-left:18px">${f.debil.map(x => `<li>${esc(x)}</li>`).join('')}</ul>` ]) })} `); } function pickSection(p) { const a = famList(p)[0]; const b = famList(p)[1]; if (!a) return ''; const lines = [`<strong>${esc(a.nombre)}</strong> se justifica cuando ${lc(a.mejorPara)}`]; if (b) lines.push(`<strong>${esc(b.nombre)}</strong>, cuando ${lc(b.mejorPara)}`); return section('cual-conviene', 'Cuál conviene en tu techo', ` <p>${lines.join('. ')}.</p> ${note(`Si tu techo tiene agua empozada, remates abiertos o más de diez años sin mantenimiento, ninguno de los dos sistemas se elige por precio: primero se corrige la causa.`)} `); } const PASOS = { 'silicona-100': [ { t: 'Inspección y prueba de humedad', d: 'Se revisa la losa, los remates y cada penetración. Si hay humedad atrapada, no se aplica.' }, { t: 'Limpieza y secado', d: 'Lavado a presión, retiro de material suelto y espera hasta que el sustrato esté seco.' }, { t: 'Corrección de grietas y remates', d: 'Se abren las grietas, se rellenan con poliuretano y se refuerzan los encuentros.' }, { t: 'Imprimador', d: 'Se aplica el imprimador compatible con la silicona para asegurar adherencia.' }, { t: 'Membrana de silicona', d: 'Dos manos cruzadas con el espesor calculado por área, no a ojo.' } ], 'acrilico-elastomerico': [ { t: 'Lavado y retiro de material suelto', d: 'El acrílico necesita una superficie limpia y porosa para agarrar.' }, { t: 'Corrección de grietas', d: 'Se abren, se rellenan y se refuerzan con malla antes de cubrir.' }, { t: 'Primera mano de base', d: 'Se aplica diluida según ficha para sellar la porosidad del concreto.' }, { t: 'Segunda mano de acabado', d: 'Con el espesor recomendado, nunca una sola mano para ahorrar producto.' }, { t: 'Curado y revisión', d: 'Se revisan remates y se documenta con fotos para la garantía.' } ], 'poliuretano': [ { t: 'Inspección y preparación', d: 'Limpieza, secado y revisión de anclajes de equipos.' }, { t: 'Corrección de juntas y grietas', d: 'Se abren y se sellan con poliuretano y malla antes de la base.' }, { t: 'Imprimador', d: 'Imprimador específico según el sustrato: concreto, metal o madera.' }, { t: 'Capa base', d: 'Base de poliuretano con el espesor del sistema, no una mano ligera.' }, { t: 'Capa de acabado', d: 'Acabado con protección UV y tiempo de curado respetado antes de caminar.' } ], 'membrana-asfaltica': [ { t: 'Evaluación de la cubierta existente', d: 'Se decide si hay que remover o si se puede recibir una capa nueva.' }, { t: 'Retiro y limpieza', d: 'Se levanta el material suelto y se limpia la losa hasta el sustrato.' }, { t: 'Imprimador asfáltico', d: 'Se aplica el imprimador y se deja curar según ficha.' }, { t: 'Base y capa de acabado', d: 'Se instala la base con el traslape especificado y luego la capa de acabado.' }, { t: 'Registro de garantía', d: 'Se documenta y se registra con el fabricante dentro del plazo que exige.' } ], 'membrana-liquida': [ { t: 'Limpieza profunda', d: 'Se retira polvo, grasa y material suelto; se lava y se deja secar.' }, { t: 'Corrección de grietas y resanes', d: 'Se rellenan grietas y se corrigen hundimientos con mortero.' }, { t: 'Imprimador', d: 'Imprimador de la misma marca, aplicado con la cobertura declarada.' }, { t: 'Capa base', d: 'Se aplica la base y se refuerzan los puntos críticos con malla.' }, { t: 'Capa de acabado', d: 'Acabado con protección UV; en terrazas se añade arena de sílice para agarre.' } ], 'sistema-multicapa': [ { t: 'Inspección y diagnóstico', d: 'Se identifica el sistema previo y se decide si califica para garantía.' }, { t: 'Preparación de superficie', d: 'Lavado a presión, retiro de material suelto y secado completo.' }, { t: 'Corrección de grietas y empozamiento', d: 'Se abren grietas y se corrige el agua parada antes de impermeabilizar.' }, { t: 'Imprimador del sistema', d: 'Paso obligatorio del protocolo: su ausencia anula la garantía.' }, { t: 'Membrana y acabado', d: 'Se aplica la membrana por área calculada y se cierra con el acabado.' } ], 'tpo-pvc': [ { t: 'Especificación del sistema', d: 'Se define espesor, fijación y accesorios según el proyecto y la carga.' }, { t: 'Retiro de la cubierta existente', d: 'Se evalúa la humedad atrapada y se retira lo necesario.' }, { t: 'Aislamiento y fijación', d: 'Se coloca el aislamiento y la fijación mecánica o el adhesivo especificado.' }, { t: 'Soldadura de juntas', d: 'Las juntas se sueldan y se prueban; una junta sin probar no es una junta.' }, { t: 'Detalles y garantía de fábrica', d: 'Se rematan penetraciones y se registra el sistema con el fabricante.' } ], 'metal-zinc': [ { t: 'Revisión de tornillos y traslapes', d: 'Se reponen tornillos y arandelas antes de cualquier producto.' }, { t: 'Limpieza a presión', d: 'Se retira el polvo, el moho y la oxidación suelta de cada panel.' }, { t: 'Sellado de traslapes', d: 'Poliuretano flexible con malla de poliéster en cada junta y tornillo.' }, { t: 'Refuerzo de encuentros', d: 'Se sellan las uniones con pared, cumbreras y penetraciones.' }, { t: 'Recubrimiento general', d: 'Acabado compatible con metal, con protección UV y anticorrosiva.' } ], 'losa-cementicia': [ { t: 'Diagnóstico de pendiente y grietas', d: 'Se mide el drenaje y se marcan las grietas activas.' }, { t: 'Corrección de pendiente', d: 'Se rellena con mortero hasta el mínimo que pide el código.' }, { t: 'Reparación de grietas y remates', d: 'Se abren, se rellenan y se reconstruyen zarpas y chaflanes.' }, { t: 'Curado del concreto', d: 'No se impermeabiliza sobre concreto fresco ni húmedo.' }, { t: 'Sistema de sellado', d: 'Se aplica el sistema elegido sobre una base sana y seca.' } ] }; function stepsSection(p) { const list = PASOS[p.familias[0]] || PASOS['sistema-multicapa']; return section('como-se-aplica', 'Cómo se aplica en un techo de Puerto Rico', ` <p>El orden importa más que la marca. Este es el proceso que exige el sistema, no el que se puede acortar para cerrar el trabajo en un día.</p> ${steps(list)} `); } function ilatekPanel(p) { const fams = famList(p); const marcas = marcaList(p); const title = marcas.length ? `Ilatek Property Solution frente a ${marcaNames(p)}` : `Ilatek Property Solution y la ${fams.length === 1 ? fams[0].nombre.toLowerCase() : famNames(p).toLowerCase()}`; const body = [ marcas.length ? `No somos afiliados, distribuidores ni representantes de ${esc(marcaNames(p))}. Trabajamos con el sistema que tu techo necesita, no con el que tenemos que empujar este mes.` : `Trabajamos con ${esc(famNames(p).toLowerCase())} y con los demás sistemas que se venden en Puerto Rico. No somos afiliados de ninguna marca: la necesidad de tu techo va por encima de la etiqueta del producto.`, `Antes de cotizar subimos al techo, revisamos la causa y te decimos si de verdad necesitas reemplazar o si el problema se corrige con menos. Si el sistema que pides no le conviene a tu losa, se avisa antes de empezar el trabajo.` ]; const bl = [ 'Inspección en el techo, no por teléfono ni por foto.', 'Corrección de la causa: grietas, pendiente, remates y anclajes.', 'Cotización por escrito con área, sistema, número de manos y garantía.', 'Garantía escrita y documentación fotográfica del antes y el después.' ]; return panel({ title, body, bullets: bl, cta: { path: '/cotizacion-techos', label: 'Agendar inspección de techos' } }); } function errorsSection(p) { const a = famList(p)[0]; if (!a) return ''; const errs = a.debil.slice(0, 4); return section('errores', 'Los errores que arruinan este trabajo', ` ${bullets(errs.map(e => esc(e)))} ${note(`El error más caro de todos es aplicar sobre una superficie que no está seca. Si el pronóstico no da una ventana seca, se pospone: rehacer cuesta más que esperar.`)} `); } function faqFor(p) { const match = PREGUNTAS.filter(q => (q.familias || []).some(f => p.familias.includes(f))); const pool = match.length >= 3 ? match : PREGUNTAS; const start = hash(p.slug) % pool.length; const out = []; for (let i = 0; i < pool.length && out.length < 3; i++) { const q = pool[(start + i * 7) % pool.length]; if (!out.some(x => x.id === q.id)) out.push(q); } return out; } function clusterFor(p) { const counts = new Map(); for (const q of PREGUNTAS) { if ((q.familias || []).some(f => p.familias.includes(f))) { counts.set(q.cluster, (counts.get(q.cluster) || 0) + 1); } } let best = null; for (const [id, n] of counts) if (!best || n > best.n) best = { id, n }; return CLUSTERS.find(c => c.id === (best ? best.id : 'materiales')); } function relatedFor(p, all = catalogo.posts) { const scored = all.filter(o => o.slug !== p.slug).map((o) => { let s = 0; s += o.familias.filter(f => p.familias.includes(f)).length * 3; s += o.marcas.filter(m => p.marcas.includes(m)).length * 4; if (o.sustrato && o.sustrato === p.sustrato) s += 2; if (o.grupo !== p.grupo) s += 2; return { o, s }; }).sort((a, b) => b.s - a.s || a.o.slug.localeCompare(b.o.slug)); // Uno de cada grupo distinto, para que la red no se cierre sobre sí misma. const out = []; const grupos = new Set(); for (const { o } of scored) { if (grupos.has(o.grupo)) continue; grupos.add(o.grupo); out.push(o); if (out.length === 3) break; } for (const { o } of scored) { if (out.length === 4) break; if (!out.includes(o)) out.push(o); } return out.slice(0, 4); } // ——— página de un post ——— const LONGTAIL = JSON.parse(fs.readFileSync(new URL('./data/longtail.json', import.meta.url), 'utf8')); function buildPost(p, all) { const ed = ED.get(p.slug); const cluster = clusterFor(p); const baseFaqs = faqFor(p); const lt = LONGTAIL.posts[p.slug]; const extraFaqs = lt ? lt.preguntas.filter(q => !baseFaqs.some(b => b.pregunta === q.pregunta)) : []; const faqs = [..baseFaqs..extraFaqs]; const fams = famList(p); const marcas = marcaList(p); const sections = []; if (ed) { sections.push(section('editorial', 'Lo que hay que entender antes de comparar', paras([esc(ed.intro)]))); for (const [i, s] of ed.secciones.entries()) { sections.push(section('analisis-' + (i + 1), s.h2, paras(s.p.map(x => esc(x))))); } } sections.push(section('comparacion', 'Comparación de un vistazo', compareTable(p))); sections.push(systemsSection(p)); sections.push(prosConsSection(p)); sections.push(priceSection(p)); // La tabla 5×8 solo donde se comparan sistemas: los 21 posts de familia. // Repetirla en los 100 posts sería contenido duplicado sin valor añadido. if (p.grupo === 'familia') { sections.push(section('tabla-sistemas', 'Los cinco sistemas, con precio y duración publicados', comparisonTableHtml({ tableClass: 'ilb-table', wrapperClass: 'ilb-scroll', caption: 'Precio y duración publicados por Ilatek (noviembre 2026). Se confirman en la inspección.', hrefFor: (id) => url(systemPath(id)) }))); } if (p.grupo === 'marca') { for (const m of marcas) { const block = brandBlock(p, m, FAM, { hrefFor: (f) => url(f.landing) }); if (block) sections.push(section('marca-' + m.id, 'Dónde encaja ' + m.nombre + ' en tu techo', table(block))); } } if (p.grupo === 'intencion') { const block = intentBlock(p, fams, { hrefFor: (f) => url(f.landing) }); if (block) sections.push(section('sistemas-de-la-respuesta', 'El sistema que responde esta pregunta', table(block))); } sections.push(pickSection(p)); sections.push(ilatekPanel(p)); sections.push(stepsSection(p)); sections.push(errorsSection(p)); if (ed) sections.push(verdict(esc(ed.veredicto))); sections.push(section('preguntas', 'Preguntas frecuentes', faq(baseFaqs), '', 3)); if (lt) { sections.push(section('preguntas-longtail', 'Preguntas y tabla de esta página', ` ${faq(extraFaqs)} ${table({ caption: lt.tabla.caption, headers: lt.tabla.headers, rows: lt.tabla.rows.map(r => r.map(c => esc(c))) })} `, '', 3)); } sections.push(section('red', 'Guías relacionadas dentro de Ilatek', ` ${bullets([ `${link('/blog/' + cluster.slug, 'Preguntas frecuentes: ' + cluster.nombre)}`, `${link('/blog/comparativas', 'Todas las comparativas de sistemas de sellado')}`, `${link('/blog/comunidades-y-servicios', 'Comunidades y servicios de Ilatek en Puerto Rico')}`..fams.slice(0, 2).map(f => link(f.landing, 'Servicio de ' + f.nombre.toLowerCase() + ' con Ilatek')) ])} `)); sections.push(ctaBlock({ title: `Sella tu techo con ${fams[0] ? fams[0].nombre.toLowerCase() : 'Ilatek'}, con garantía escrita`, text: `Cuéntanos qué techo tienes y qué está pasando. La inspección se hace en el techo y la cotización va por escrito, con el sistema, el número de manos y la garantía. Si tu techo no necesita lo que crees, te lo decimos.`, path: '/cotizacion-techos', label: 'Cotiza tu sellado con Ilatek' })); sections.push(legal({ marcas: marcas.length ? marcas.map(m => m.nombre) : sistemas.marcas.filter(m => m.familias.some(f => p.familias.includes(f))).slice(0, 3).map(m => m.nombre) })); sections.push(sources([ ..marcas.flatMap(m => m.fuentes)..fams.map(f => 'https://ilatekpr.com' + f.landing)..faqs.map(q => q.fuente) ])); const articleHtml = [ quick(esc(p.angulo)), toc([ { id: 'comparacion', label: 'Comparación de un vistazo' }, { id: 'que-es-cada-sistema', label: p.grupo === 'marca' ? 'Qué vende cada marca' : 'Qué es cada sistema' }, { id: 'ventajas-y-desventajas', label: 'Ventajas y desventajas' }, { id: 'precio-publicado', label: 'Precio publicado' }, { id: 'como-se-aplica', label: 'Cómo se aplica' }, { id: 'preguntas', label: 'Preguntas frecuentes' }..(lt ? [{ id: 'preguntas-longtail', label: 'Preguntas y tabla' }] : []) ])..sections ].join('\n'); // El H1 no repite el ángulo del Title: se queda con el sujeto comparado y // descarta la cláusula que revela la intención de búsqueda. const h1 = p.h1.split(':')[0].trim(); const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Comparativas', path: '/blog/comparativas' }, { label: h1 } ]; const asideHtml = [ asideService({ visit: false }), asideFaqCluster(cluster), relatedCard(relatedFor(p, all).map(o => ({ slug: o.slug, h1: o.h1, kicker: KICKER[o.grupo] }))) ].join('\n'); const schemas = [ articleSchema({ slug: p.slug, h1, meta: p.meta, about: fams.map(f => f.nombre), mentions: marcas.map(m => m.nombre), words: words(articleHtml), section: KICKER[p.grupo], keywords: [p.kw..fams.map(f => f.nombre)..marcas.map(m => m.nombre)].filter(Boolean) }), breadcrumbSchema(crumbItems, '/blog/' + p.slug), faqSchema(faqs, '/blog/' + p.slug) ]; return page({ pathname: '/blog/' + p.slug, heroHtml: hero({ crumbItems, eyebrow: KICKER[p.grupo], h1, dek: dekFor(p), imagen: imagenDePost(p), tags: [ ..fams.map(f => f.nombre)..marcas.map(m => m.nombre), 'Puerto Rico', 'Precio publicado' ].slice(0, 6) }), articleHtml, asideHtml, schemas }); } // ——— páginas de preguntas frecuentes ——— const CLUSTER_INTRO = { precio: 'El precio es la duda que más se busca y la que peor se contesta en la isla: circulan cifras de $1.75 y de $6.50 por pie cuadrado para el mismo techo. Aquí están las publicadas, con fuente y fecha, y el criterio para leerlas.', materiales: 'Qué sistema dura más, cuál aguanta el agua emparada y por qué dos fabricantes serios no coinciden en los años de la silicona. Las respuestas cortas y la guía completa de cada una.', proceso: 'Cómo se aplica, cuánto tarda, qué pasa si el techo está mojado y cuándo el problema se resuelve con menos de lo que te cotizaron.', 'garantia-leyes': 'Garantías, licencias, la Junta de Impermeabilización y quién paga en un condominio. Es la parte que casi nadie explica y la que más te protege.', clima: 'La isla impone su calendario: temporada de huracanes, ondas tropicales y agua que no drena. Cuándo sellar y qué pasa si se hace en la semana equivocada.', sustratos: 'Una losa de concreto, un techo de zinc y uno de teja no se sellan igual. Qué pide cada sustrato y qué producto es un error en cada uno.' }; function buildCluster(c) { const qs = PREGUNTAS.filter(q => q.cluster === c.id); const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Preguntas frecuentes', path: '/blog/preguntas-frecuentes' }, { label: c.nombre } ]; // Mismo criterio que en los posts: el H1 nombra el tema, sin la muletilla // que repite el Title ("Preguntas frecuentes: …"). const h1 = `${c.nombre.charAt(0).toUpperCase() + c.nombre.slice(1)} en Puerto Rico`; const articleHtml = [ quick('Precio, materiales, proceso, garantía, licencias y clima: cada pregunta con una respuesta corta y el enlace a la guía completa.'), toc(qs.map((q, i) => ({ id: 'q' + (i + 1), label: q.pregunta })))..qs.map((q, i) => section('q' + (i + 1), q.pregunta, ` <p>${esc(q.respuesta)}</p> <p>${link('/blog/' + q.post, 'Guía completa: ' + q.post.replace(/-/g, ' '))}</p> `, '', 3)), section('todas', 'Todas las preguntas de esta categoría', table({ caption: 'Pregunta, respuesta corta y guía completa.', headers: ['Pregunta', 'Guía completa'], rows: qs.map(q => [ `<strong>${esc(q.pregunta)}</strong><small>${esc(q.respuesta.slice(0, 120))}…</small>`, link('/blog/' + q.post, 'Leer la comparativa') ]) })), section('servicios', 'Servicios de techos que resuelven estas dudas', `<ul>${clusterLinks(c.id, { urlFor: url })}</ul>`), section('red', 'Sigue por aquí', bullets([ link('/blog/preguntas-frecuentes', 'Todas las preguntas frecuentes'), link('/blog/comparativas', 'Las ' + catalogo.posts.length + ' comparativas de sistemas y marcas'), link('/blog/comunidades-y-servicios', 'Comunidades y servicios de Ilatek'), link('/cotizacion-techos', 'Cotizar una inspección de techos') ])), ctaBlock({ title: 'Tu pregunta no está aquí', text: 'Si tu techo tiene una condición que no aparece en esta lista, escríbenos. La inspección se hace en el techo y te decimos qué sistema pide tu caso, aunque no te vendamos nada.', label: 'Preguntar por mi techo' }), legal({}) ].join('\n'); const asideHtml = [ asideService({ visit: false }), relatedCard(qs.slice(0, 3).map(q => ({ slug: q.post, h1: q.pregunta, kicker: 'Guía completa' }))) ].join('\n'); const schemas = [ breadcrumbSchema(crumbItems, '/blog/' + c.slug), faqSchema(qs.map(q => ({ pregunta: q.pregunta, respuesta: q.respuesta })), '/blog/' + c.slug), itemListSchema({ path: '/blog/' + c.slug, name: h1, items: qs.map((q, i) => ({ path: '/blog/' + c.slug + '#q' + (i + 1), name: q.pregunta })) }), { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url('/blog/' + c.slug), url: url('/blog/' + c.slug), name: h1, inLanguage: 'es-PR', breadcrumb: { '@id': url('/blog/' + c.slug) + '#breadcrumb' }, datePublished: FECHA, dateModified: FECHA } ]; return { path: '/blog/' + c.slug, file: '01-preguntas-frecuentes/' + c.slug + '.html', title: h1, description: `Preguntas frecuentes sobre ${lc(c.nombre)} del sellado de techos en Puerto Rico: respuestas cortas, precios publicados y guías completas de cada tema.`, keyword: 'preguntas frecuentes sellado de techos ' + lc(c.nombre), cluster: c.id, grupo: 'faq', html: page({ pathname: '/blog/' + c.slug, heroHtml: heroLite({ crumbItems, eyebrow: 'Preguntas frecuentes', h1, dek: CLUSTER_INTRO[c.id] }), articleHtml, asideHtml, schemas }) }; } // ——— puentes a comunidades y servicios ——— const SERVICIOS = [ ['Sellado de techos', '/sellado-de-techos', 'Los cinco sistemas: silicona, membrana, elastomérico, poliuretano y acrílico.'], ['Sellado de silicona 100%', '/sellado-de-silicona', 'Losa plana, agua empozada y juntas.'], ['Membrana asfáltica', '/membrana-asfaltica', 'Sistema en rollo con garantía de fabricante.'], ['Recubrimiento elastomérico', '/recubrimiento-elastomerico', 'Acabado reflectivo para concreto y superficies porosas.'], ['Sellado de poliuretano', '/sellado-de-poliuretano', 'Tránsito, equipos y terrazas.'], ['Sellado acrílico', '/sellado-acrilico', 'Mantenimiento preventivo con presupuesto contenido.'], ['Impermeabilización de techos', '/impermeabilizacion-de-techos', 'Cubierta continua para toda la losa.'], ['Techos de concreto', '/techos-de-concreto', 'Grietas, pendiente y remates.'], ['Techos de zinc', '/techos-de-zinc', 'Tornillos, traslapes y dilatación del metal.'], ['Techos planos', '/techos-planos', 'Drenaje y sistemas para losa sin pendiente.'], ['Techos de asfalto', '/techos-de-asfalto', 'Compatibilidad y capa nueva.'], ['Techos de teja', '/techos-de-teja', 'Juntas y remates, no capa continua.'], ['Techos de madera', '/techos-de-madera', 'Movimiento, ventilación y piezas.'], ['Reparación de goteras', '/reparacion-de-goteras', 'Punto de entrada identificado.'], ['Reparación de filtraciones', '/reparacion-de-filtraciones', 'Diagnóstico y corrección de la causa.'], ['Reparación de grietas', '/reparacion-de-grietas-techos', 'Apertura, relleno y refuerzo.'], ['Empozamiento de techos', '/empozamiento-de-techos', 'Pendiente y drenaje antes de sellar.'], ['Reparación post huracán', '/reparacion-post-huracan', 'Documentación, lona y trabajo definitivo.'], ['Inspección de techos', '/inspeccion-de-techos', 'Diagnóstico antes de cotizar.'], ['Mantenimiento de techos', '/mantenimiento-de-techos', 'Inspección anual y repaso programado.'], ['Tragaluces', '/tragaluces', 'Penetraciones y remates.'], ['Instalación y reemplazo de techos', '/instalacion-y-reemplazo-de-techos', 'Cuando el sellado ya no es opción.'], ['Sellado comercial', '/sellado-de-techos-comercial', 'Techo comercial con garantía de fábrica.'], ['Sellado industrial', '/sellado-de-techos-industrial', 'Galpones y naves.'], ['Sellado residencial', '/sellado-de-techos-residencial', 'Casa, presupuesto y calendario.'] ]; const PUENTES = [ { slug: 'sellado-de-techos-con-ilatek-property-solution', h1: 'Sellado de techos con Ilatek Property Solution', kicker: 'Quiénes somos', dek: 'Trabajamos con todos los sistemas de sellado que se venden en Puerto Rico y no somos afiliados de ninguna marca. La necesidad de tu techo va primero; después se elige el producto.', familias: ['silicona-100', 'membrana-asfaltica', 'poliuretano'], extra: ` ${section('como-trabajamos', 'Cómo trabajamos', steps([ { t: 'Escuchamos y subimos al techo', d: 'La inspección se hace en la propiedad, no por teléfono. Se revisa la losa, los remates, las penetraciones y el drenaje.' }, { t: 'Diagnosticamos la causa', d: 'Una filtración puede venir de una grieta, de un remate abierto o de una pendiente que no existe. Se identifica antes de cotizar.' }, { t: 'Elegimos el sistema contigo', d: 'Te explicamos qué sistema pide tu techo y qué cuesta cada uno. Si el que pediste no conviene, te lo decimos.' }, { t: 'Cotizamos por escrito', d: 'Área, sistema, número de manos, preparación incluida y garantía. Sin partidas sorpresa a mitad de trabajo.' }, { t: 'Ejecutamos y documentamos', d: 'Fotos del antes y el después, garantía escrita y recomendaciones de mantenimiento.' } ]))} ${section('por-que', 'Por qué no vendemos una sola marca', ` <p>Porque no todos los techos son iguales. Una losa con agua empozada pide silicona; un techo con equipos pide poliuretano; una nave industrial pide una membrana especificada. Vender siempre el mismo producto obliga a meter el techo en la caja, y ahí es donde aparecen las filtraciones al año.</p> <p>Eso incluye decirte cuándo el trabajo se puede resolver con menos de lo que te cotizaron y cuándo el sistema barato te va a costar el doble.</p> `)}` }, { slug: 'ilatek-y-el-sellado-de-silicona', h1: 'Ilatek y el sellado de silicona 100%', kicker: 'Sistema: silicona', dek: 'La silicona es el sistema que mejor aguanta el agua empozada en una losa. También es el que más exige preparación. Así lo aplicamos.', familias: ['silicona-100'], extra: '' }, { slug: 'ilatek-y-la-membrana-asfaltica', h1: 'Ilatek y la membrana asfáltica', kicker: 'Sistema: membrana asfáltica', dek: 'Cuando la losa ya no da para otra capa, la membrana asfáltica es la salida con garantía de fabricante. Así se especifica y se instala.', familias: ['membrana-asfaltica'], extra: '' }, { slug: 'ilatek-y-el-recubrimiento-elastomerico', h1: 'Ilatek y el recubrimiento elastomérico', kicker: 'Sistema: elastomérico', dek: 'El sistema de mantenimiento con mejor relación precio-año en concreto sano. También el que más se aplica mal por ahorrar una mano.', familias: ['acrilico-elastomerico'], extra: '' }, { slug: 'ilatek-y-el-sellado-de-poliuretano', h1: 'Ilatek y el sellado de poliuretano', kicker: 'Sistema: poliuretano', dek: 'Para techos con equipos, tránsito y terrazas. Es el sistema que aguanta que alguien camine, y el que peor tolera la humedad al aplicar.', familias: ['poliuretano'], extra: '' }, { slug: 'ilatek-y-el-sellado-acrilico', h1: 'Ilatek y el sellado acrílico', kicker: 'Sistema: acrílico', dek: 'La opción de mantenimiento preventivo cuando el concreto está sano. Con expectativas claras: no es un sistema de veinte años.', familias: ['acrilico-elastomerico'], extra: '' }, { slug: 'comunidades-ilatekpr-como-funciona', h1: 'Sellado de techos en tu comunidad en Puerto Rico', kicker: 'Comunidades', dek: 'Ilatek tiene una página por comunidad en Puerto Rico, con el sellado de techos y la limpieza como servicios separados. Aquí ves cómo encontrar la tuya.', familias: ['silicona-100'], extra: '', comunidades: true }, { slug: 'guia-de-servicios-de-techos-de-ilatek', h1: 'Guía de servicios de techos de Ilatek', kicker: 'Servicios', dek: 'Todos los servicios de techos que Ilatek tiene publicados, agrupados por lo que resuelven, para que llegues al que necesitas sin dar vueltas.', familias: ['sistema-multicapa'], extra: '', servicios: true } ]; function comunidadesData() { const file = path.resolve(BLOG, './Comunidades/data/mapa-comunidades.json'); if (!fs.existsSync(file)) return null; return JSON.parse(fs.readFileSync(file, 'utf8')); } function buildPuente(b) { const fams = famList(b); const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Comunidades y servicios', path: '/blog/comunidades-y-servicios' }, { label: b.h1 } ]; const partes = []; if (b.familias.length === 1 && !b.servicios && !b.comunidades) { const f = fams[0]; partes.push(quick(esc(`Ilatek aplica ${f.nombre.toLowerCase()} con el protocolo completo: inspección, preparación, imprimador cuando el sistema lo exige y garantía escrita. No somos afiliados de ninguna marca.`))); partes.push(section('el-sistema', 'Qué es y para qué sirve', paras([ esc(f.material), `<strong>Dónde gana:</strong> ${esc(f.mejorPara)}`, `<strong>Dónde falla:</strong> ${esc(f.debil[0])} ${esc(f.debil[1] || '')}` ]))); partes.push(section('como-lo-aplicamos', 'Cómo lo aplicamos', steps(PASOS[f.id] || PASOS['sistema-multicapa']))); partes.push(section('precio', 'Qué dice el precio publicado', ` <p>${esc(f.precioPublicado)}</p> ${note('Ilatek no publica un precio por pie cuadrado sin ver el techo: la cifra cambia con el área, las penetraciones y la condición de la losa. La cotización va por escrito y sin sorpresas.')} `)); partes.push(section('comparativas', 'Compara antes de decidir', bullets([ link('/blog/silicona-100-vs-poliuretano', 'Silicona 100% vs. poliuretano'), link('/blog/membrana-asfaltica-vs-membrana-liquida', 'Membrana asfáltica vs. membrana líquida'), link('/blog/que-sistema-de-sellado-dura-mas-anos', 'Qué sistema dura más años'), link('/blog/cuanto-cuesta-sellar-un-techo-en-puerto-rico', 'Cuánto cuesta sellar un techo en Puerto Rico') ]))); } if (b.comunidades) { const data = comunidadesData(); if (data) { const munis = data.regions.flatMap(r => r.municipalities); const publicadas = munis.flatMap(m => m.communities.filter(c => c.published).map(c => ({ ..c, municipio: m.name }))); partes.push(quick(`comunidades.ilatekpr.com es el sitio donde Ilatek tiene una página por comunidad, con dos servicios separados: sellado de techos y limpieza. Cubre ${data.totals.municipalities} municipios y ${data.totals.communitiesPublished} comunidades con página publicada.`)); partes.push(section('como-funciona', 'Cómo está organizado', paras([ `La jerarquía es fija: municipio, comunidad y servicio. Cada página cubre un solo servicio, así que no hay página de comunidad con menú: la raíz lleva al servicio de techos y la de limpieza se enlaza desde ahí.`, `El sitio principal, ilatekpr.com, conserva las páginas de sistema y de categoría. El subdominio de comunidades resuelve la búsqueda local, que es distinta: quien busca en su urbanización quiere saber si llegamos a su calle, no qué es una membrana asfáltica.` ]))); partes.push(section('regiones', 'Cobertura por región', table({ caption: `${data.totals.municipalities} municipios, ${data.totals.communitiesPublished} comunidades con página publicada.`, headers: ['Región', 'Municipios', 'Comunidades con página'], rows: data.regions.map(r => [ `<strong>${esc(r.label)}</strong>`, String(r.municipalities.length), String(r.municipalities.reduce((a, m) => a + m.communities.filter(c => c.published).length, 0)) ]) }))); if (publicadas.length) { partes.push(section('ejemplos', 'Comunidades con página publicada', ` <p>Estas son algunas de las páginas activas. Cada una enlaza al sellado de techos de esa comunidad.</p> ${bullets(publicadas.slice(0, 12).map(c => `<a href="${esc(c.url + '/sellado-de-techo')}" target="_blank" rel="noopener noreferrer">${esc(c.name)}</a> <span style="color:#5b6380">· ${esc(c.municipio)}</span>`))} `)); } partes.push(note('Las páginas de comunidad están en comunidades.ilatekpr.com y por eso se enlazan con la dirección completa. No forman parte de este blog: aquí solo se explica cómo encontrarlas.')); } else { partes.push(quick('comunidades.ilatekpr.com es el sitio donde Ilatek tiene una página por comunidad, con dos servicios: sellado de techos y limpieza.')); } partes.push(section('enlaces', 'Llega a tu comunidad', bullets([ link('/blog/comunidades-y-servicios', 'Índice de comunidades y servicios'), link('/blog/guia-de-servicios-de-techos-de-ilatek', 'Guía de servicios de techos'), link('/sellado-de-techos', 'Sellado de techos en Puerto Rico') ]))); } if (b.servicios) { partes.push(quick('Ilatek tiene una página por cada servicio de techos. Esta guía los agrupa por lo que resuelven, con el enlace directo a cada uno.')); partes.push(section('servicios', 'Servicios de techos publicados', table({ caption: 'Cada fila es un servicio de techos publicado en ilatekpr.com.', headers: ['Servicio', 'Qué resuelve'], rows: SERVICIOS.map(([n, p, d]) => [`${link(p, n)}`, esc(d)]) }))); partes.push(section('por-donde-empezar', 'Por dónde empezar', bullets([ link('/blog/cuanto-cuesta-sellar-un-techo-en-puerto-rico', 'Si tu duda es el precio'), link('/blog/que-sistema-de-sellado-dura-mas-anos', 'Si tu duda es cuál sistema dura más'), link('/blog/licencia-y-permisos-para-sellado-de-techo-en-puerto-rico', 'Si quieres verificar al contratista'), link('/blog/sellado-de-techos-con-ilatek-property-solution', 'Si quieres saber cómo trabajamos') ]))); } partes.push(b.extra || ''); partes.push(ctaBlock({ title: 'Cotiza tu sellado con Ilatek', text: 'Inspección en el techo, cotización por escrito y garantía. Te decimos qué sistema pide tu techo aunque no sea el que tenías en mente.', label: 'Agendar inspección' })); partes.push(legal({})); partes.push(sources([ ..fams.map(f => 'https://ilatekpr.com' + f.landing), 'https://ilatekpr.com/home' ])); const articleHtml = partes.filter(Boolean).join('\n'); const asideHtml = [ asideService({ visit: false }), relatedCard([ { slug: 'sellado-de-techos-con-ilatek-property-solution', h1: 'Cómo trabajamos el sellado', kicker: 'Ilatek' }, { slug: 'guia-de-servicios-de-techos-de-ilatek', h1: 'Guía de servicios de techos', kicker: 'Servicios' }, { slug: 'comunidades-ilatekpr-como-funciona', h1: 'Sellado de techos en tu comunidad', kicker: 'Comunidades' } ].filter(x => x.slug !== b.slug)) ].join('\n'); const schemas = [ breadcrumbSchema(crumbItems, '/blog/' + b.slug), webPageSchema({ path: '/blog/' + b.slug, name: b.h1, description: b.dek }) ]; return { path: '/blog/' + b.slug, file: '03-comunidades-servicios/' + b.slug + '.html', title: b.h1, description: b.dek.slice(0, 158), keyword: b.kicker.toLowerCase() + ' ilatek', cluster: 'puente', grupo: 'puente', html: page({ pathname: '/blog/' + b.slug, heroHtml: heroLite({ crumbItems, eyebrow: b.kicker, h1: b.h1, dek: b.dek }), articleHtml, asideHtml, schemas }) }; } // ——— índices ——— const RAIL_JS = `<script> (function(){ var rails = [].slice.call(document.querySelectorAll('.ilb-hubsec [data-rail]')); if (!rails.length) return; rails.forEach(function(rail, index){ var dir = index % 2 === 0 ? 1 : -1; var paused = false, frame = null, dragging = false, startX = 0, startLeft = 0, moved = 0, resumeTimer = null; var speed = 26, last = 0, carry = 0; function maxScroll(){ return rail.scrollWidth - rail.clientWidth; } function wrap(){ var max = maxScroll(); if (max <= 2) return; if (dir > 0 && rail.scrollLeft >= max - 0.5) rail.scrollLeft = 0; else if (dir < 0 && rail.scrollLeft <= 0.5) rail.scrollLeft = max; } function tick(now){ frame = null; if (paused || dragging || document.hidden) return; if (!last) last = now; var dt = Math.min(64, now - last); last = now; if (maxScroll() > 2) { carry += dt * speed / 1000; var step = Math.floor(carry); if (step > 0) { carry -= step; rail.scrollLeft += dir * step; wrap(); } } frame = window.requestAnimationFrame(tick); } function play(){ if (!frame) { last = 0; frame = window.requestAnimationFrame(tick); } } function pause(){ paused = true; if (frame) { window.cancelAnimationFrame(frame); frame = null; } } function resume(){ paused = false; play(); } if (dir < 0) rail.scrollLeft = maxScroll(); rail.addEventListener('pointerenter', pause); rail.addEventListener('pointerleave', function(){ if (!dragging) resume(); }); rail.addEventListener('focusin', pause); rail.addEventListener('focusout', function(){ if (!dragging) resume(); }); document.addEventListener('visibilitychange', function(){ if (document.hidden) pause(); else resume(); }); rail.addEventListener('pointerdown', function(e){ if (e.pointerType !== 'mouse' || e.button !== 0) { pause(); return; } dragging = true; moved = 0; startX = e.clientX; startLeft = rail.scrollLeft; rail.classList.add('is-dragging'); try { rail.setPointerCapture(e.pointerId); } catch (err) {} pause(); }); rail.addEventListener('pointermove', function(e){ if (!dragging) return; var dx = e.clientX - startX; moved = Math.max(moved, Math.abs(dx)); rail.scrollLeft = startLeft - dx; }); function endDrag(e){ if (e.pointerType !== 'mouse') { window.clearTimeout(resumeTimer); resumeTimer = window.setTimeout(resume, 1200); return; } if (!dragging) return; dragging = false; rail.classList.remove('is-dragging'); try { rail.releasePointerCapture(e.pointerId); } catch (err) {} if (!rail.matches(':hover')) resume(); } rail.addEventListener('pointerup', endDrag); rail.addEventListener('pointercancel', endDrag); rail.addEventListener('click', function(e){ if (moved > 6) { e.preventDefault(); e.stopPropagation(); moved = 0; } }, true); rail.addEventListener('keydown', function(e){ if (e.key === 'ArrowRight'){ rail.scrollLeft += 280; e.preventDefault(); } else if (e.key === 'ArrowLeft'){ rail.scrollLeft -= 280; e.preventDefault(); } }); play(); }); })(); </script>`; function buildHubComparativas(pages) { const grupos = [ ['familia', 'Sistema contra sistema'], ['marca', 'Marca contra marca'], ['sustrato', 'Por tipo de techo'], ['intencion', 'Precio, proceso y garantía'] ]; const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Comparativas' } ]; const answerHtml = quick('En este blog vas a comparar silicona, poliuretano, acrílico, membrana asfáltica y sistemas de marca por precio publicado, duración, garantía y tipo de techo, con la fuente de cada cifra, hasta encontrar el que pide tu techo.', '¿Cuál es el mejor sistema de sellado de techo en Puerto Rico?'); const interludes = [ { text: 'El sistema se elige por el techo, no por la marca. Una silicona puede rendir en una losa inclinada y fallar en una losa plana que acumula agua; una membrana asfáltica resiste más, pero suma peso y días de obra. Esta tabla resume el punto de partida antes de comparar precios.', table: { caption: 'Qué sistema conviene según el trabajo', headers: ['Sistema', 'Dónde rinde', 'Punto débil', 'Cuándo elegirlo'], rows: [ ['Silicona 100%', 'Losas y techos con pendiente', 'No perdona humedad atrapada', 'Superficie seca y grietas resueltas'], ['Poliuretano', 'Techos con tránsito y juntas', 'El UV lo degrada sin acabado', 'Necesitas elasticidad y resistencia'], ['Acrílico elastomérico', 'Techos reflectivos y sol directo', 'Menos puenteo en grietas activas', 'Buscas reflectividad y mantenimiento simple'], ['Membrana asfáltica', 'Losas planas y sistemas multicapa', 'Suma peso y días de obra', 'Quieres una barrera reforzada'] ] } }, { text: 'Dentro de cada familia, la línea importa más que el logo. Dos productos de la misma marca pueden tener distinta elasticidad, distinto rendimiento y distinta garantía. Compara siempre la ficha del producto que se va a aplicar, no la del catálogo general.', table: { caption: 'Qué distingue a las marcas que más se comparan', headers: ['Marca', 'Línea que verás', 'Enfoque', 'Ideal para'], rows: [ ['Sika', 'Sikalastic y Sikaflex', 'Impermeabilización y reparación', 'Losas, juntas y goteras puntuales'], ['Lanco', 'Lanco Seal y White Seal', 'Selladores elastoméricos', 'Techos residenciales y reflectivos'], ['Soprema', 'Soprema y Polyglass', 'Membranas asfálticas', 'Losas planas de mayor área'], ['Top Coat', 'Marin y Cintron', 'Recubrimientos de exposición', 'Metal, concreto y ambientes salinos'], ['King of Silicone', 'Silicona 100%', 'Adherencia y elasticidad', 'Techos con pendiente y superficie seca'] ] } }, { text: 'El tipo de techo decide la preparación, no solo el producto. Concreto, metal, madera y techo reflectivo piden limpiezas, imprimadores y fijaciones distintas; aplicar el mismo sistema en todos es la forma más cara de repetir el trabajo.', table: { caption: 'Sistema recomendado por tipo de techo', headers: ['Techo', 'Sistema que mejor se adapta', 'Por qué', 'Antes de aplicar'], rows: [ ['Concreto con pendiente', 'Silicona 100% o acrílico', 'Adhiere y sella grietas capilares', 'Secado, limpieza y grietas resueltas'], ['Losa plana', 'Membrana asfáltica o poliuretano', 'Forma una capa continua', 'Drenaje, juntas y peso disponible'], ['Zinc o metal', 'Recubrimiento elastomérico', 'Acompaña la dilatación del metal', 'Tornillería, óxido y limpieza'], ['Madera', 'Sellador flexible', 'La madera se mueve con la humedad', 'Humedad, clavos y ventilación'], ['Techo reflectivo', 'Acrílico reflectivo', 'Reduce la absorción de calor', 'Limpieza previa y capas uniformes'] ] } } ]; const interlude = (i) => interludes[i] ? `<div class="ilb-interlude"><p>${interludes[i].text}</p>${table(interludes[i].table)}</div>` : ''; const articleHtml = [ ..grupos.map(([g, label], i) => { const list = pages.filter(p => p.grupo === g); if (!list.length) return ''; return section('grupo-' + g, label, `<p class="ilb-count">${list.length} guías</p> <ul class="ilb-gridcards" data-rail tabindex="0" aria-label="${esc(label)}">${list.map(p => gridCard({ href: url('/blog/' + p.slug), kicker: KICKER[g], title: p.h1, text: p.meta.slice(0, 118) + '…', image: cardImage(p) })).join('')}</ul>`, 'ilb-hubsec') + interlude(i); }), ctaBlock({ title: 'No compares a ciegas', text: 'Si no sabes qué sistema tiene tu techo, una inspección lo resuelve en una visita. ', label: 'Agendar inspección' }), RAIL_JS ].join('\n'); return { path: '/blog/comparativas', file: '02-comparativas/index.html', title: 'Comparativas de sistemas de sellado de techos en Puerto Rico', description: `Las ${catalogo.posts.length} comparativas de sellado de techos: sistema contra sistema, marca contra marca, por tipo de techo y por duda de precio o garantía.`, keyword: 'comparativas sellado de techos puerto rico', cluster: 'indice', grupo: 'indice', html: page({ pathname: '/blog/comparativas', heroHtml: heroLite({ crumbItems, eyebrow: 'Comparativas', h1: 'Compara sistemas, marcas y precios de sellado de techos en Puerto Rico', dek: 'Silicona, poliuretano, membrana asfáltica, sistemas de marca y todo lo que se interpone entre tu techo y una filtración. Con precios publicados y fuente de cada cifra.', imagen: { src: 'https://assets.cdn.filesafe.space/8OxUENFVM60EKzqsTcoD/media/6ac8583d89da6e6f9bc73cb9.jpg', alt: 'Técnicos de Ilatek revisando con una tableta el techo de una casa antes de cotizar el sellado', width: 1200, height: 670 }, cta: visitCard(), answer: answerHtml }), articleHtml, asideHtml: asideService({ visit: false }), schemas: [ breadcrumbSchema(crumbItems, '/blog/comparativas'), itemListSchema({ path: '/blog/comparativas', name: 'Comparativas de sellado de techos', items: pages.map(p => ({ path: '/blog/' + p.slug, name: p.h1 })) }), { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url('/blog/comparativas'), url: url('/blog/comparativas'), name: 'Comparativas de sellado de techos', inLanguage: 'es-PR', breadcrumb: { '@id': url('/blog/comparativas') + '#breadcrumb' }, datePublished: FECHA, dateModified: FECHA } ] }) }; } function buildHubPreguntas(clusterPages) { const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Preguntas frecuentes' } ]; const articleHtml = [ quick(`Seis categorías con las ${PREGUNTAS.length} preguntas más frecuentes sobre sellado de techos en Puerto Rico. Cada respuesta enlaza a la guía completa.`)..clusterPages.map(c => section('c-' + c.cluster, c.title, ` <p>${esc(CLUSTER_INTRO[c.cluster])}</p> <p>${link(c.path, 'Ver las ' + PREGUNTAS.filter(q => q.cluster === c.cluster).length + ' preguntas de ' + c.cluster.replace(/-/g, ' '))}</p> `)), section('metodo', 'Cómo se construyó este archivo de preguntas', paras([ `Las preguntas salen de los bloques de «Otras preguntas» de Google para las consultas de sellado de techos en Puerto Rico, de títulos de hilos de Reddit en r/PuertoRico y de publicaciones de grupos de contratistas en Facebook. No se inventó ninguna: se recogieron y se respondieron con lo que se puede sostener con una fuente pública.`, `Cada respuesta lleva su fuente y la fecha de verificación. Cuando no existe un dato publicado, se dice. Cuando dos fuentes serias se contradicen —por ejemplo en la duración de la silicona— se reporta la contradicción en vez de escoger la cifra más conveniente.` ])), ctaBlock({ title: 'Tu duda no está en la lista', text: 'Escríbenos con lo que está pasando en tu techo. La inspección y la respuesta es técnica, no un discurso de venta.', label: 'Preguntar por mi techo' }) ].join('\n'); return { path: '/blog/preguntas-frecuentes', file: '01-preguntas-frecuentes/index.html', title: 'Preguntas frecuentes sobre sellado de techos en Puerto Rico', description: 'Precio, materiales, proceso, garantía, licencias y clima: las preguntas más frecuentes sobre sellado de techos en Puerto Rico, con respuesta y fuente.', keyword: 'preguntas frecuentes sellado de techos puerto rico', cluster: 'indice', grupo: 'indice', html: page({ pathname: '/blog/preguntas-frecuentes', heroHtml: heroLite({ crumbItems, eyebrow: 'Investigación de preguntas', h1: 'Preguntas frecuentes sobre sellado de techos en Puerto Rico', dek: 'Un archivo de respuestas cortas, con fuente, para las dudas reales de quien tiene una losa filtrando y no sabe a quién creerle.' }), articleHtml, asideHtml: asideService({}), schemas: [ breadcrumbSchema(crumbItems, '/blog/preguntas-frecuentes'), itemListSchema({ path: '/blog/preguntas-frecuentes', name: 'Preguntas frecuentes de sellado de techos', items: clusterPages.map(c => ({ path: c.path, name: c.title })) }), { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url('/blog/preguntas-frecuentes'), url: url('/blog/preguntas-frecuentes'), name: 'Preguntas frecuentes de sellado de techos', inLanguage: 'es-PR', breadcrumb: { '@id': url('/blog/preguntas-frecuentes') + '#breadcrumb' }, datePublished: FECHA, dateModified: FECHA } ] }) }; } function buildHubPuentes(pages) { const crumbItems = [ { label: 'Ilatek', path: '/home' }, { label: 'Blog', path: '/blog' }, { label: 'Comunidades y servicios' } ]; const articleHtml = [ quick('Ilatek trabaja con todos los sistemas de sellado y no es afiliado de ninguna marca. Aquí están las páginas que explican cómo se aplica cada sistema, cómo están organizadas las páginas por comunidad y cuáles son todos los servicios de techos.'), section('puentes', 'Cómo trabajamos y dónde llegamos', ` <ul class="ilb-gridcards">${pages.map(p => gridCard({ href: url(p.path), kicker: p.kicker || 'Ilatek', title: p.h1, text: p.dek.slice(0, 120) + '…', image: cardImage(p) })).join('')}</ul> `), section('servicios', 'Servicios de techos publicados', bullets(SERVICIOS.slice(0, 12).map(([n, p]) => link(p, n)))), ctaBlock({ title: 'Sella tu techo con Ilatek', text: 'Inspección en el techo, cotización por escrito y garantía. Si tu techo no necesita lo que crees, te lo decimos.', label: 'Cotizar mi sellado' }) ].join('\n'); return { path: '/blog/comunidades-y-servicios', file: '03-comunidades-servicios/index.html', title: 'Comunidades y servicios de Ilatek en Puerto Rico', description: 'Qué servicios de techos ofrece Ilatek, cómo están organizadas las páginas por comunidad en Puerto Rico y cómo trabaja cada sistema de sellado.', keyword: 'comunidades y servicios ilatek', cluster: 'indice', grupo: 'indice', html: page({ pathname: '/blog/comunidades-y-servicios', heroHtml: heroLite({ crumbItems, eyebrow: 'Comunidades y servicios', h1: '¿Dónde trabaja Ilatek y qué servicios ofrece?', dek: 'Las páginas por comunidad, los servicios de techos y el criterio con el que elegimos el sistema para cada techo.', }), articleHtml, asideHtml: asideService({}), schemas: [ breadcrumbSchema(crumbItems, '/blog/comunidades-y-servicios'), itemListSchema({ path: '/blog/comunidades-y-servicios', name: 'Comunidades y servicios de Ilatek', items: pages.map(p => ({ path: p.path, name: p.h1 })) }), { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url('/blog/comunidades-y-servicios'), url: url('/blog/comunidades-y-servicios'), name: 'Comunidades y servicios de Ilatek', inLanguage: 'es-PR', breadcrumb: { '@id': url('/blog/comunidades-y-servicios') + '#breadcrumb' }, datePublished: FECHA, dateModified: FECHA } ] }) }; } function buildHubBlog(comparativas, clusters, puentes) { const crumbItems = [{ label: 'Ilatek', path: '/home' }, { label: 'Blog' }]; const articleHtml = [ quick(`El blog de Ilatek reúne ${comparativas.length} comparativas de sistemas de sellado, ${clusters.length} archivos de preguntas frecuentes y ${puentes.length} páginas sobre comunidades y servicios. Todo con precios publicados y fuente.`), section('secciones', 'Las tres secciones', ` <ul class="ilb-gridcards"> ${gridCard({ href: url('/blog/comparativas'), kicker: 'Comparativas', title: 'Sistema contra sistema y marca contra marca', text: 'Silicona, poliuretano, acrílico, membrana asfáltica, TPO y los sistemas de marca que se venden en la isla.', image: cardImage('membrana') })} ${gridCard({ href: url('/blog/preguntas-frecuentes'), kicker: 'Preguntas frecuentes', title: 'Preguntas frecuentes sobre sellado de techos', text: 'Precio, duración, garantía, licencias, clima y tipo de techo, con respuesta corta y fuente.', image: cardImage('mantenimiento') })} ${gridCard({ href: url('/blog/comunidades-y-servicios'), kicker: 'Comunidades y servicios', title: 'Dónde llegamos y cómo trabajamos', text: 'Las páginas por comunidad, los servicios de techos y el criterio para elegir el sistema de cada techo.', image: cardImage('planos') })} </ul> `), section('precio', 'Si solo tienes una duda: el precio', ` <p>Las tres guías que más se consultan sobre dinero, con las cifras publicadas por empresas de Puerto Rico y la fecha de verificación.</p> ${bullets([ link('/blog/cuanto-cuesta-sellar-un-techo-en-puerto-rico', 'Cuánto cuesta sellar un techo en Puerto Rico'), link('/blog/precio-por-pie-cuadrado-sellado-de-techo', 'Precio por pie cuadrado, sistema por sistema'), link('/blog/por-que-varia-el-precio-del-sellado-de-techo', 'Por qué varía tanto el precio') ])} `), section('recientes', 'Todas las comparativas', `<p class="ilb-count">${comparativas.length} guías</p> <ul class="ilb-gridcards">${comparativas.slice(0, 18).map(p => gridCard({ href: url('/blog/' + p.slug), kicker: KICKER[p.grupo], title: p.h1, text: p.meta.slice(0, 110) + '…', image: cardImage(p) })).join('')}</ul> <p style="margin-top:18px">${link('/blog/comparativas', 'Ver las ' + comparativas.length + ' comparativas')}</p>`), ctaBlock({ title: 'Cotiza tu sellado con Ilatek', text: 'Inspección en el techo y cotización por escrito con sistema, manos y garantía. Si tu techo no necesita lo que crees, te lo decimos.', label: 'Agendar inspección' }) ].join('\n'); return { path: '/blog', file: 'index.html', title: 'Blog de sellado de techos en Puerto Rico | Ilatek', description: 'Comparativas de sistemas de sellado, precios publicados y preguntas frecuentes de Puerto Rico. Todo con fuente, fecha de verificación y sin afiliación de marcas.', keyword: 'blog sellado de techos puerto rico', cluster: 'indice', grupo: 'indice', html: page({ pathname: '/blog', heroHtml: heroLite({ crumbItems, eyebrow: 'Blog Ilatek', h1: 'Sellado de techos en Puerto Rico: precios, sistemas y garantías', dek: 'Cien comparativas de sistemas y marcas, un archivo de preguntas investigadas y el mapa de comunidades y servicios. Sin afiliación con las marcas que citamos.', imagen: { src: 'https://assets.cdn.filesafe.space/8OxUENFVM60EKzqsTcoD/media/6ac8583d89da6e6f9bc73cb9.jpg', alt: 'Técnicos de Ilatek revisando con una tableta el techo de una casa antes de cotizar el sellado', width: 1200, height: 670 } }), articleHtml, asideHtml: asideService({}), schemas: [ breadcrumbSchema(crumbItems, '/blog'), itemListSchema({ path: '/blog', name: 'Secciones del blog', items: [ { path: '/blog/comparativas', name: 'Comparativas de sellado de techos' }, { path: '/blog/preguntas-frecuentes', name: 'Preguntas frecuentes' }, { path: '/blog/comunidades-y-servicios', name: 'Comunidades y servicios' } ] }), blogSchema({ posts: catalogo.posts }) ] }) }; } // ——— ejecución ——— const posts = catalogo.posts; const salida = []; function emitir(entry, html) { const dir = path.join(BLOG, path.dirname(entry.file)); fs.mkdirSync(dir, { recursive: true }); const final = '<meta charset="utf-8">\n' + composeShell(html, entry.path); fs.writeFileSync(path.join(BLOG, entry.file), final); salida.push(entry); } // Vista previa de una sola página: no toca índices, CSV, sitemap ni el resto del lote. if (process.env.BLOG_ONLY) { const slug = process.env.BLOG_ONLY; const p = posts.find(x => x.slug === slug); if (!p) { console.error(`No existe el post: ${slug}`); process.exit(1); } const html = buildPost(p, posts); emitir({ path: '/blog/' + p.slug, file: '02-comparativas/posts/' + p.slug + '.html', title: p.titulo, description: p.meta, keyword: p.kw, cluster: clusterFor(p).id, grupo: p.grupo, h1: p.h1, slug: p.slug }, html); console.log(`Preview: ${p.slug} (${html.length} chars)`); process.exit(0); } for (const p of posts) { const html = buildPost(p, posts); emitir({ path: '/blog/' + p.slug, file: '02-comparativas/posts/' + p.slug + '.html', title: p.titulo, description: p.meta, keyword: p.kw, cluster: clusterFor(p).id, grupo: p.grupo, h1: p.h1, slug: p.slug }, html); } const clusterPages = CLUSTERS.map(buildCluster); for (const c of clusterPages) emitir(c, c.html); const puentePages = PUENTES.map(buildPuente); for (const b of puentePages) emitir(b, b.html); const hubComparativas = buildHubComparativas(posts); const hubPreguntas = buildHubPreguntas(clusterPages); const hubPuentes = buildHubPuentes(PUENTES.map((b, i) => ({ ..b, path: '/blog/' + b.slug, dek: b.dek }))); const hubBlog = buildHubBlog(posts, clusterPages, PUENTES); for (const h of [hubComparativas, hubPreguntas, hubPuentes, hubBlog]) emitir(h, h.html); // ——— artefactos ——— salida.sort((a, b) => a.path.localeCompare(b.path)); fs.writeFileSync(path.join(BLOG, 'indice.json'), JSON.stringify({ generado: new Date().toISOString(), total: salida.length, paginas: salida.map(({ path: p, file, title, description, keyword, cluster, grupo }) => ({ path: p, file, title, description, keyword, cluster, grupo })) }, null, 2)); const csvEsc = (s) => '"' + String(s).replace(/"/g, '""') + '"'; const csv = ['ruta,titulo,descripcion,canonical,seccion,palabra_clave'] .concat(salida.map(p => [p.path, p.title, p.description, SITE + p.path, p.cluster, p.keyword].map(csvEsc).join(','))) .join('\n'); fs.mkdirSync(path.join(BLOG, 'seo'), { recursive: true }); fs.writeFileSync(path.join(BLOG, 'seo/seo-blog.csv'), csv + '\n'); const sitemap = `<?xml version="1.0" encoding="UTF-8"?> <!-- ilatekpr.com — blog. Generado por blog/build/build-blog.mjs; no editar a mano. Publica estas URLs solo cuando cada página exista en GHL. --> <urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"> ${salida.map(p => ` <url> <loc>${SITE}${p.path}</loc> <lastmod>${FECHA}</lastmod> <changefreq>monthly</changefreq> <priority>${p.path === '/blog' ? '0.9' : '0.7'}</priority> </url>`).join('\n')} </urlset> `; fs.writeFileSync(path.join(BLOG, 'sitemap-blog.xml'), sitemap); const inv = `# Inventario del lote de blog Generado por \`blog/build/build-blog.mjs\` el ${FECHA}. ${salida.length} páginas. | Ruta | Archivo | Sección | Palabra clave | |---|---|---|---| ${salida.map(p => `| ${p.path} | \`${p.file}\` | ${p.cluster} | ${p.keyword} |`).join('\n')} `; fs.writeFileSync(path.join(BLOG, 'INVENTARIO.md'), inv); console.log(`Blog: ${salida.length} páginas generadas.`); console.log(` comparativas: ${posts.length}`); console.log(` preguntas: ${clusterPages.length}`); console.log(` puentes: ${puentePages.length}`); console.log(` índices: 4`);
